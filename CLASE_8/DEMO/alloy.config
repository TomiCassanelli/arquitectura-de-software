// Docker discovery encuentra los contenedores del daemon conectado.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Conservamos solo los logs del servicio `app` de esta presentación.
discovery.relabel "app_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex = "app"
    action = "keep"
  }

  // Esta etiqueta permite buscar {service="app"} en Grafana.
  rule {
    target_label = "service"
    replacement = "app"
  }
}

// Alloy lee stdout/stderr de los contenedores elegidos.
loki.source.docker "app" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.app_logs.output
  forward_to = [loki.write.local.receiver]
}

// La URL usa el nombre interno del servicio Loki, no localhost del host.
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
